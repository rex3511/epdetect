# TMDB Read Access Token (API settings at https://www.themoviedb.org/settings/api)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# OpenRouter API key (for jev arbitration on low-confidence matches)
OPENROUTER_API_KEY=your_openrouter_key_here

# LM Studio base URL (local models: summaries, embeddings, clef)
LM_STUDIO_URL=http://host.docker.internal:1234

# Model IDs as listed by LM Studio /v1/models
SUMMARY_MODEL=google/gemma-4-e4b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
CLEF_MODEL=cloudflare_clef-flash
JEV_MODEL=typesafe/jev-router

# Confidence threshold for auto-renaming (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.85

# Directory containing your MKV files
DATA_DIR=./data

# Output directory for renamed files (optional, defaults to source folder)
OUTPUT_DIR=./output
